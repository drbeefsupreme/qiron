#!/bin/bash
set -eu
umask 077
cd -- "$(dirname -- "$0")"
if [[ -z ${OPERATOR_PASSWORD:-} ]]; then
  read -r -s -p 'Set a booth password (at least 3 characters): ' OPERATOR_PASSWORD
  echo
fi
if [[ ${#OPERATOR_PASSWORD} -lt 3 ]]; then
  echo 'Use at least 3 characters.' >&2
  exit 1
fi
join_file="${XDG_CONFIG_HOME:-$HOME/.config}/qiron/join-wifi"
if [[ -f $join_file ]]; then
  mapfile -t join_lines < "$join_file"
  if (( ${#join_lines[@]} != 2 )); then
    echo 'The join-wifi file needs two lines: Wi-Fi name, then password.' >&2
    exit 1
  fi
  export QYRON_JOIN_SSID="${QYRON_JOIN_SSID-${join_lines[0]}}"
  export QYRON_JOIN_PASSWORD="${QYRON_JOIN_PASSWORD-${join_lines[1]}}"
fi
callin_file="${XDG_CONFIG_HOME:-$HOME/.config}/qiron/callin-number"
if [[ -f $callin_file && -z ${QYRON_CALLIN_NUMBER:-} ]]; then
  QYRON_CALLIN_NUMBER=$(<"$callin_file")
  export QYRON_CALLIN_NUMBER
fi
phrases_file="${XDG_CONFIG_HOME:-$HOME/.config}/qiron/phrases.json"
if [[ -f $phrases_file ]]; then
  export QYRON_PHRASES_FILE="${QYRON_PHRASES_FILE:-$phrases_file}"
fi
export OPERATOR_PASSWORD
export SHOW_FILE="${SHOW_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/qiron/show.etf}"
exec bin/qiron start
